{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "bundler",
    "noEmit": true
  },
  "include": [
    ".rnstorybook/**/*.ts",
    ".rnstorybook/**/*.tsx",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "plugins/**/*.ts",
    "App.tsx",
    "index.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
