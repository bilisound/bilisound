{
  "name": "bilisound",
  "private": true,
  "scripts": {
    "build": "turbo build --cache-dir .turbo/cache",
    "dev": "turbo dev --cache-dir .turbo/cache",
    "lint": "turbo lint --cache-dir .turbo/cache",
    "cleanup": "turbo cleanup",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "postinstall": "pnpm build",
    "prepare": "node ./scripts/install-skills.mjs",
    "prettier:fix": "prettier -w --ignore-unknown .",
    "spell": "cspell lint .",
    "spell:fix": "cspell lint --show-suggestions --no-must-find-files ."
  },
  "devDependencies": {
    "cspell": "^10.0.1",
    "prettier": "^3.9.6",
    "skills": "^1.5.23",
    "skills-npm": "^1.2.0",
    "turbo": "^2.10.11"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.22.0"
}
