{
  "name": "bilisound",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "postinstall": "pnpm run build",
    "prepare": "node ./scripts/install-skills.mjs",
    "prettier:fix": "prettier -w --ignore-unknown .",
    "spell": "cspell lint .",
    "spell:fix": "cspell lint --show-suggestions --no-must-find-files ."
  },
  "devDependencies": {
    "cspell": "^10.0.0",
    "prettier": "^3.8.0",
    "skills": "^1.5.9",
    "skills-npm": "^1.1.1",
    "turbo": "^2.7.5"
  },
  "pnpm": {
    "overrides": {
      "@expo/dom-webview": "~56.0.5"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.28.1"
}
