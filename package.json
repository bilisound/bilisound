{
  "name": "bilisound",
  "private": true,
  "scripts": {
    "build": "turbo build --cache-dir .turbo/cache",
    "dev": "turbo dev --cache-dir .turbo/cache",
    "lint": "turbo lint --cache-dir .turbo/cache",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "postinstall": "pnpm run build",
    "prepare": "node ./scripts/install-skills.mjs",
    "prettier:fix": "prettier -w --ignore-unknown .",
    "spell": "cspell lint .",
    "spell:fix": "cspell lint --show-suggestions --no-must-find-files ."
  },
  "devDependencies": {
    "cspell": "^10.0.0",
    "prettier": "^3.8.0",
    "skills": "^1.5.9",
    "skills-npm": "^1.1.1",
    "turbo": "^2.7.5"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.7.0+sha512.19cc852c120c7125760f2443ee6be0ca5b40f9f50598de1a09a1f177503e010e57c23c77646e01e761de59bf874fb22a3398c33ab9691fc13eb946b6f0f4d620"
}
